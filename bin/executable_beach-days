#!/usr/bin/env python3
"""Put "good beach day" windows on a Beach Days calendar.

Small Point beach is only walkable at low tide. This crosses NOAA tide predictions
with the NWS forecast and writes one event per low tide that lands in a civilized
window. The weather barely gates at all — an otherwise nice day is worth surfacing
— it picks the emoji so the verdict reads off the calendar.

Each run reconciles: events are created, updated in place as the forecast firms up,
and deleted when a window stops qualifying. The calendar IS the state; there is no
seen-file.

    beach-days            # dry run, prints the plan
    beach-days --write    # apply it
    beach-days --test     # self-check, no network

ponytail: no config file, no cache, no DB. Tune the constants below.
"""
import json, subprocess, sys, urllib.request
from datetime import datetime, timedelta

# --- knobs -------------------------------------------------------------------
STATION   = "8417177"          # NOAA Fort Popham, Hunniwell Point ME
LATLON    = "43.755,-69.785"   # the tide station itself — same NWS grid as the beach
CALENDAR  = "Beach Days"       # dedicated: reconciling needs a calendar small enough
                               # to scan, and Calendar.app cannot query a big one
DAYS      = 14                 # NWS only forecasts ~7; tides go the full range
EARLIEST  = 11                 # Dana won't go before 11am
LATEST    = 19                 # and not after dark
MIN_TEMP  = 55                 # °F — below this it is not a beach, it is a walk
MAX_POP   = 70                 # % precip — only a near-certain soaking is disqualifying
WARM_EBB  = (16, 19)           # a low tide in this window drains a sun-baked marsh
TIDE_PAD  = timedelta(hours=2) # event spans low tide ± this
UA        = {"User-Agent": "beach-days (dana@caravel.bio)"}


def get(url):
    return json.load(urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=30))


def low_tides(start, days):
    """[(datetime, height_ft)] for every low tide in the range."""
    url = ("https://api.tidesandcurrents.noaa.gov/api/prod/datagetter?product=predictions"
           f"&datum=MLLW&station={STATION}&time_zone=lst_ldt&units=english&interval=hilo"
           f"&begin_date={start:%Y%m%d}&end_date={start + timedelta(days=days):%Y%m%d}&format=json")
    return [(datetime.strptime(p["t"], "%Y-%m-%d %H:%M"), float(p["v"]))
            for p in get(url)["predictions"] if p["type"] == "L"]


def daytime_forecast():
    """{date: period} for the daytime NWS periods."""
    fc = get(get(f"https://api.weather.gov/points/{LATLON}")["properties"]["forecast"])
    return {datetime.fromisoformat(p["startTime"]).date(): p
            for p in fc["properties"]["periods"] if p["isDaytime"]}


# --- what kind of day is it --------------------------------------------------

# First match wins. Ordered worst-to-best so a bad sky beats a warm number.
CONDITIONS = [
    ("snow sleet wintry",   "🌨"),
    ("thunder storm",       "⛈"),
    ("rain shower drizzle", "🌧"),
    ("fog haze",            "🌫"),
    ("wind breezy",         "🌬"),
]
SUNNY = ("🏖", "😎")


def emoji(period):
    """A glyph for the day, so the calendar is skimmable without opening anything."""
    sky = period["shortForecast"].lower()
    if pop_of(period) >= 50:
        return "🌧"
    for words, glyph in CONDITIONS:
        if any(w in sky for w in words.split()):
            return glyph
    if "cloud" in sky or "overcast" in sky:
        return "☁️"
    if period["temperature"] >= 70:
        return "🏖"          # the real thing: warm and clear
    return "😎"              # clear but cool — still a good walk


def pop_of(period):
    return (period.get("probabilityOfPrecipitation") or {}).get("value") or 0


def warm_water(when, period):
    """Is this a warm-water day?

    The marsh fills at high tide, sits in the sun all afternoon, and then drains
    back into the river on the ebb — so a LATE-afternoon low tide means the whole
    sunny afternoon's worth of warmed water is running past you. High tide is
    ~6h before low, so a 4-7pm low puts the fill around 10am-1pm: a full soak.

    Needs actual sun on the marsh during that soak, so a grey day kills it.

    ponytail: a heuristic, not a thermal model. If the river disagrees, move
    WARM_EBB — that is the calibration knob.
    """
    return WARM_EBB[0] <= when.hour < WARM_EBB[1] and emoji(period) in SUNNY


def verdict(when, period):
    """None if it's a good beach window, else the reason it isn't."""
    if not EARLIEST <= when.hour < LATEST:
        return f"low tide at {when:%-I:%M %p}"
    if period is None:
        return "beyond the forecast"
    if period["temperature"] < MIN_TEMP:
        return f"only {period['temperature']}°F"
    if pop_of(period) > MAX_POP:
        return f"{pop_of(period)}% chance of rain"
    return None


def describe(when, height, period):
    """(title, notes) for the event."""
    warm = warm_water(when, period)
    glyph = "🏊" if warm else emoji(period)
    title = (f"{glyph} Small Point — low tide {when:%-I:%M %p}, "
             f"{period['temperature']}°F {period['shortForecast']}")
    notes = f"Low tide {height:.1f} ft at {when:%-I:%M %p} (NOAA {STATION}).\n"
    if warm:
        notes += ("Warm water: the marsh filled this morning, baked all afternoon, and is "
                  "draining into the river right through this window.\n")
    notes += period["detailedForecast"]
    return title, notes.replace('"', "'").replace("\n", " ")


# --- Calendar.app ------------------------------------------------------------

MKDATE = """
on mkdate(y, m, d, secs)
  set dt to current date
  set day of dt to 1
  set year of dt to y
  set month of dt to m
  set day of dt to d
  set time of dt to secs
  return dt
end mkdate
"""


def asdate(dt):
    """An AppleScript date expression for `dt`.

    ponytail: NOT `date "2026-09-19 09:47:00"` — AppleScript parses that
    locale-dependently and silently produced October 9, year 12187. Setting the
    components one at a time is the only unambiguous form. Day goes to 1 first so
    setting month cannot overflow a 31st into the next month.
    """
    return f"(my mkdate({dt.year}, {dt.month}, {dt.day}, {dt.hour * 3600 + dt.minute * 60}))"


def osa(script):
    subprocess.run(["open", "-ga", "Calendar"], check=False)  # -600 if it isn't running
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"osascript failed: {r.stderr.strip()}")
    return r.stdout.strip()


def existing():
    """{start-datetime: (uid, summary)} for everything currently on the calendar.

    Keyed by start date because that is what a low tide determines. A plain
    `every event` scan is only tractable because this calendar holds a handful of
    events — the same scan against a full personal calendar never returns.
    """
    osa(f'''tell application "Calendar"
      if not (exists calendar "{CALENDAR}") then make new calendar with properties {{name:"{CALENDAR}"}}
    end tell''')
    out = osa(f'''tell application "Calendar"
      tell calendar "{CALENDAR}"
        set out to ""
        repeat with e in (every event)
          set d to start date of e
          set out to out & (uid of e) & tab & (year of d as string) & "-" & (month of d as integer as string) & "-" & (day of d as string) & "-" & (hours of d as string) & "-" & (minutes of d as string) & tab & (summary of e) & linefeed
        end repeat
        return out
      end tell
    end tell''')
    found = {}
    for line in out.splitlines():
        if not line.strip():
            continue
        uid, stamp, summary = line.split("\t", 2)
        y, mo, d, h, mi = (int(x) for x in stamp.split("-"))
        found[datetime(y, mo, d, h, mi)] = (uid, summary)
    return found


def apply(creates, updates, deletes):
    """One osascript round trip for the whole reconcile — each one costs ~15s."""
    body = ""
    for start, end, title, notes in creates:
        body += (f'    make new event with properties {{summary:"{title}", '
                 f'start date:{asdate(start)}, end date:{asdate(end)}, description:"{notes}"}}\n')
    if updates or deletes:
        wanted = "{" + ", ".join(f'"{u}"' for u, _, _ in updates) + "}"
        doomed = "{" + ", ".join(f'"{u}"' for u in deletes) + "}"
        body += f'''    set doomed to {{}}
    repeat with e in (every event)
      set u to uid of e
      if u is in {doomed or "{}"} then set end of doomed to (contents of e)
'''
        for uid, title, notes in updates:
            body += (f'      if u is "{uid}" then\n'
                     f'        set summary of e to "{title}"\n'
                     f'        set description of e to "{notes}"\n'
                     f'      end if\n')
        body += '''    end repeat
    repeat with e in doomed
      delete e
    end repeat
'''
    if not body:
        return
    osa(MKDATE + f'''tell application "Calendar"
  tell calendar "{CALENDAR}"
{body}  end tell
end tell''')


def main(write):
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    wx = daytime_forecast()
    have = existing()
    creates, updates, keep = [], [], set()

    for when, height in low_tides(today, DAYS):
        if when < datetime.now():
            continue
        period = wx.get(when.date())
        why_not = verdict(when, period)
        if why_not:
            print(f"  {when:%a %b %-d}  skip — {why_not}")
            continue
        title, notes = describe(when, height, period)
        start = when - TIDE_PAD
        if start in have:
            keep.add(start)
            uid, old = have[start]
            if old == title:
                print(f"  {when:%a %b %-d}  unchanged  {title}")
            else:
                updates.append((uid, title, notes))
                print(f"  {when:%a %b %-d}  UPDATE     {title}\n{'':>25}(was: {old})")
        else:
            creates.append((start, when + TIDE_PAD, title, notes))
            print(f"  {when:%a %b %-d}  CREATE     {title}")

    deletes = [uid for start, (uid, summary) in have.items() if start not in keep]
    for start, (uid, summary) in sorted(have.items()):
        if start not in keep:
            print(f"  {start:%a %b %-d}  DELETE     {summary}")

    if not write:
        print("\ndry run — rerun with --write to apply")
        return
    apply(creates, updates, deletes)
    print(f"\n{len(creates)} created, {len(updates)} updated, {len(deletes)} deleted")


def test():
    def p(t, pop, sky="Sunny"):
        return {"temperature": t, "shortForecast": sky, "detailedForecast": sky + ".",
                "probabilityOfPrecipitation": {"value": pop}}
    d = datetime(2026, 9, 20, 13, 0)

    assert emoji(p(75, 0)) == "🏖"
    assert emoji(p(58, 0)) == "😎"                          # cool but clear still surfaces
    assert emoji(p(75, 0, "Mostly Cloudy")) == "☁️"
    assert emoji(p(75, 10, "Chance Rain Showers")) == "🌧"  # sky beats a low pop
    assert emoji(p(75, 60, "Sunny")) == "🌧"                # pop beats a nice-sounding sky
    assert emoji(p(75, 0, "Chance Thunderstorms")) == "⛈"
    assert emoji(p(40, 0, "Snow")) == "🌨"
    assert emoji(p(75, 0, "Patchy Fog")) == "🌫"
    assert emoji({"temperature": 75, "shortForecast": "Sunny",
                  "probabilityOfPrecipitation": None}) == "🏖"

    assert verdict(d, p(75, 10)) is None
    assert verdict(d.replace(hour=8), p(75, 10)) == "low tide at 8:00 AM"
    assert verdict(d.replace(hour=20), p(75, 10)) == "low tide at 8:00 PM"
    assert verdict(d, p(60, 10)) is None          # 60°F now surfaces
    assert verdict(d, p(50, 10)) == "only 50°F"
    assert verdict(d, p(75, 60)) is None          # 60% rain now surfaces
    assert verdict(d, p(75, 90)) == "90% chance of rain"
    assert verdict(d, None) == "beyond the forecast"

    warm = d.replace(hour=17)
    assert warm_water(warm, p(72, 0))                        # late ebb + sun
    assert warm_water(warm, p(58, 0))                        # cool air, warm water anyway
    assert not warm_water(warm, p(72, 0, "Rain Showers"))    # no sun, no soak
    assert not warm_water(d.replace(hour=12), p(72, 0))      # midday low: marsh never baked
    assert not warm_water(d.replace(hour=19), p(72, 0))      # past the window
    assert describe(warm, 1.2, p(72, 0))[0].startswith("🏊")
    assert "marsh filled" in describe(warm, 1.2, p(72, 0))[1]
    assert describe(d, 1.2, p(72, 0))[0].startswith("🏖")

    assert asdate(datetime(2026, 9, 19, 9, 47)) == "(my mkdate(2026, 9, 19, 35220))"
    assert asdate(datetime(2026, 1, 31, 0, 0)) == "(my mkdate(2026, 1, 31, 0))"
    print("ok")


if __name__ == "__main__":
    test() if "--test" in sys.argv else main("--write" in sys.argv)
