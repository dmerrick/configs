#!/usr/bin/env python3
"""Put "good beach day" windows on the Maine calendar.

Small Point beach is only walkable at low tide. This crosses NOAA tide predictions
with the NWS forecast and writes one event per day where a low tide lands in a
civilized window. The weather barely gates at all — an otherwise nice day is
worth surfacing — it picks the emoji so the verdict reads off the calendar.

    beach-days            # dry run, prints what it would add
    beach-days --write    # actually create the events
    beach-days --test     # self-check, no network

ponytail: no config file, no cache, no DB. Tune the constants below.
"""
import json, pathlib, subprocess, sys, urllib.request
from datetime import datetime, timedelta

# --- knobs -------------------------------------------------------------------
STATION   = "8417177"          # NOAA Fort Popham, Hunniwell Point ME (~4 mi from Small Point)
LATLON    = "43.755,-69.785"   # the tide station itself (Hunniwell Point) — same NWS grid as the beach
CALENDAR  = "Maine"
DAYS      = 14                 # NWS only forecasts ~7; tides go the full range
EARLIEST  = 11                 # Dana won't go before 11am
LATEST    = 19                 # and not after dark
MIN_TEMP  = 55                 # °F — below this it is not a beach, it is a walk
MAX_POP   = 70                 # % precip — only a near-certain soaking is disqualifying
TIDE_PAD  = timedelta(hours=2) # event spans low tide ± this
UA        = {"User-Agent": "beach-days (dana@caravel.bio)"}
SEEN      = pathlib.Path.home() / ".beach-days-seen"   # events already created


def get(url):
    return json.load(urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=30))


def low_tides(start, days):
    """[(datetime, height_ft)] for every low tide in the range."""
    url = ("https://api.tidesandcurrents.noaa.gov/api/prod/datagetter?product=predictions"
           f"&datum=MLLW&station={STATION}&time_zone=lst_ldt&units=english&interval=hilo"
           f"&begin_date={start:%Y%m%d}&end_date={start + timedelta(days=days):%Y%m%d}&format=json")
    return [(datetime.strptime(p["t"], "%Y-%m-%d %H:%M"), float(p["v"]))
            for p in get(url)["predictions"] if p["type"] == "L"]


def daytime_forecast():
    """{date: period} for the daytime NWS periods."""
    fc = get(get(f"https://api.weather.gov/points/{LATLON}")["properties"]["forecast"])
    return {datetime.fromisoformat(p["startTime"]).date(): p
            for p in fc["properties"]["periods"] if p["isDaytime"]}


# First match wins. Ordered worst-to-best so a bad sky beats a warm number.
CONDITIONS = [
    ("snow sleet wintry",      "🌨"),
    ("thunder storm",          "⛈"),
    ("rain shower drizzle",    "🌧"),
    ("fog haze",               "🌫"),
    ("wind breezy",            "🌬"),
]


def emoji(period):
    """A glyph for the day, so the calendar is skimmable without opening anything."""
    sky = period["shortForecast"].lower()
    pop = (period.get("probabilityOfPrecipitation") or {}).get("value") or 0
    if pop >= 50:
        return "🌧"
    for words, glyph in CONDITIONS:
        if any(w in sky for w in words.split()):
            return glyph
    if "cloud" in sky or "overcast" in sky:
        return "☁️"
    if period["temperature"] >= 70:
        return "🏖"          # the real thing: warm and clear
    return "😎"              # clear but cool — still a good walk


def verdict(when, period):
    """None if it's a good beach window, else the reason it isn't."""
    if not EARLIEST <= when.hour < LATEST:
        return f"low tide at {when:%-I:%M %p}"
    if period is None:
        return "beyond the forecast"
    if period["temperature"] < MIN_TEMP:
        return f"only {period['temperature']}°F"
    pop = (period.get("probabilityOfPrecipitation") or {}).get("value") or 0
    if pop > MAX_POP:
        return f"{pop}% chance of rain"
    return None


def osa(script):
    subprocess.run(["open", "-ga", "Calendar"], check=False)  # -600 if it isn't running
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"osascript failed: {r.stderr.strip()}")
    return r.stdout.strip()


def asdate(dt):
    """An AppleScript date expression for `dt`.

    ponytail: NOT `date "2026-09-19 09:47:00"` — AppleScript parses that
    locale-dependently and silently produced October 9, year 12187. Setting the
    components one at a time is the only unambiguous form. Day goes to 1 first so
    setting month cannot overflow a 31st into the next month.
    """
    return f"(my mkdate({dt.year}, {dt.month}, {dt.day}, {dt.hour * 3600 + dt.minute * 60}))"


MKDATE = """
on mkdate(y, m, d, secs)
  set dt to current date
  set day of dt to 1
  set year of dt to y
  set month of dt to m
  set day of dt to d
  set time of dt to secs
  return dt
end mkdate
"""


def add_event(title, start, end, notes):
    """Idempotent via a seen-file: an AppleScript `whose summary is ...` query over
    Calendar.app takes minutes, a one-line file takes none.
    ponytail: delete SEEN to re-add everything."""
    key = f"{start:%Y-%m-%d %H:%M}"   # the tide, not the title — the forecast changes
    seen = SEEN.read_text().splitlines() if SEEN.exists() else []
    if any(line.split("\t")[1:2] == [key] for line in seen):
        return False
    uid = osa(MKDATE + f'''tell application "Calendar"
      tell calendar "{CALENDAR}"
        set e to make new event with properties {{summary:"{title}", start date:{asdate(start)}, end date:{asdate(end)}, description:"{notes}"}}
        return uid of e
      end tell
    end tell''')
    SEEN.write_text("\n".join(seen + [f"{uid}\t{key}\t{title}"]) + "\n")
    return True


def main(write):
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
    wx = daytime_forecast()
    for when, height in low_tides(today, DAYS):
        if when < datetime.now():
            continue
        period = wx.get(when.date())
        why_not = verdict(when, period)
        if why_not:
            print(f"  {when:%a %b %-d}  skip — {why_not}")
            continue
        title = (f"{emoji(period)} Small Point — low tide {when:%-I:%M %p}, "
                 f"{period['temperature']}°F {period['shortForecast']}")
        notes = (f"Low tide {height:.1f} ft at {when:%-I:%M %p} (NOAA {STATION}). "
                 f"{period['detailedForecast']}").replace('"', "'")
        if not write:
            print(f"  {when:%a %b %-d}  WOULD ADD  {title}")
            continue
        added = add_event(title, when - TIDE_PAD, when + TIDE_PAD, notes)
        print(f"  {when:%a %b %-d}  {'added' if added else 'already there'}  {title}")
    if not write:
        print("\ndry run — rerun with --write to put these on the calendar")


def test():
    p = lambda t, pop, sky="Sunny": {"temperature": t, "shortForecast": sky,
                                     "probabilityOfPrecipitation": {"value": pop}}
    assert emoji(p(75, 0)) == "🏖"
    assert emoji(p(58, 0)) == "😎"                          # cool but clear still surfaces
    assert emoji(p(75, 0, "Mostly Cloudy")) == "☁️"
    assert emoji(p(75, 10, "Chance Rain Showers")) == "🌧"  # sky beats a low pop
    assert emoji(p(75, 60, "Sunny")) == "🌧"                # pop beats a nice-sounding sky
    assert emoji(p(75, 0, "Chance Thunderstorms")) == "⛈"
    assert emoji(p(40, 0, "Snow")) == "🌨"
    assert emoji(p(75, 0, "Patchy Fog")) == "🌫"
    assert emoji({"temperature": 75, "shortForecast": "Sunny",
                  "probabilityOfPrecipitation": None}) == "🏖"
    d = datetime(2026, 9, 20, 13, 0)
    assert verdict(d, p(75, 10)) is None
    assert verdict(d.replace(hour=8), p(75, 10)) == "low tide at 8:00 AM"
    assert verdict(d.replace(hour=20), p(75, 10)) == "low tide at 8:00 PM"
    assert verdict(d, p(60, 10)) is None          # 60°F now surfaces
    assert verdict(d, p(50, 10)) == "only 50°F"
    assert verdict(d, p(75, 60)) is None           # 60% rain now surfaces
    assert verdict(d, p(75, 90)) == "90% chance of rain"
    assert verdict(d, {"temperature": 75, "probabilityOfPrecipitation": None}) is None  # null pop
    assert verdict(d, None) == "beyond the forecast"
    assert asdate(datetime(2026, 9, 19, 9, 47)) == "(my mkdate(2026, 9, 19, 35220))"
    assert asdate(datetime(2026, 1, 31, 0, 0)) == "(my mkdate(2026, 1, 31, 0))"
    print("ok")


if __name__ == "__main__":
    test() if "--test" in sys.argv else main("--write" in sys.argv)
