#!/usr/bin/env bash
# claude-next [prompt [session [stamp]]] — open a Claude window in a tmux session (ADanaLife
# unless named) and attach.
#
# The remote end of tempomat's "Fix in terminal": Blink opens
# `mosh <mac> -- claude-next '/rebase-prs tempomat 560'` over Dana's own SSH key,
# and this script decides what runs. The prompt must match the allowlist below
# — anything else is refused and the session just attaches, so the worst a
# wrong caller can do is pick a different allowlisted prompt. No argument: attach.
set -euo pipefail

# mosh-server runs this with sshd's bare PATH.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
session="${2:-ADanaLife}"
dir="$HOME/adanalife"
# The session name reaches tmux's target syntax, so only a plain name is taken.
if [[ ! $session =~ ^[A-Za-z0-9_-]+$ ]]; then
  echo "claude-next: refused session '$session'" >&2
  sleep 2
  session=ADanaLife
fi

prompt="${1:-}"
# tempomat stamps each tap with its Unix time. Blink re-runs a tab's command line
# when it restores the tab, so an old stamp is a restore, not a tap: attach only.
stamp="${3:-}"
if [ -n "$prompt" ]; then
  verdict=run
  if [ -z "$stamp" ]; then
    verdict=unstamped # shortcut: builds before the stamp still run, refuse once every device has updated
  elif [[ ! $stamp =~ ^[0-9]+$ ]] || (( $(date +%s) - stamp > 120 )); then
    verdict=replay
  fi
  echo "$(date '+%F %T') $verdict stamp=${stamp:--} '$prompt' $session" >>"$HOME/Library/Logs/claude-next.log"
  if [ "$verdict" = replay ]; then
    echo "claude-next: '$prompt' was tapped more than 2 minutes ago (a Blink restore); attaching" >&2
    sleep 2
    prompt=""
  fi
fi
if [ -n "$prompt" ]; then
  if [[ $prompt =~ ^/(clock-in|sweep-todos|rebase-prs|rebase-prs\ [a-z0-9-]+\ [0-9]+)$ ]]; then
    tmux has-session -t "$session" 2>/dev/null || tmux new-session -d -s "$session" -c "$dir"
    name="${prompt#/}"; name="${name%% *}"
    tmux new-window -t "$session" -c "$dir" -n "$name" "claude '$prompt'; exec \$SHELL"
  else
    echo "claude-next: refused '$prompt' (not an allowlisted prompt)" >&2
    sleep 2
  fi
fi
exec tmux attach -t "$session"
